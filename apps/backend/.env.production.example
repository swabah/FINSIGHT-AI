# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection (replace with your credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/finsight-ai?retryWrites=true&w=majority

# JWT Configuration (use strong, random secret - min 32 chars)
JWT_SECRET=your_production_jwt_secret_key_here_min_32_characters
JWT_EXPIRE=7d

# Google Gemini API (get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_production_google_api_key
GEMINI_MODEL=gemini-2.0-flash

# Embedding Model Configuration
EMBEDDING_MODEL=gemini-embedding-001

# Vector Store Configuration
VECTOR_SEARCH_INDEX_NAME=vector_index
TRANSACTION_CHUNK_SIZE=5

# CORS Configuration (your deployed frontend URL)
FRONTEND_URL=https://finsight-ai-frontend-ivory.vercel.app
