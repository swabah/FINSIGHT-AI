# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/finsight-ai?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# LLM Configuration (Google Gemini - FREE)
# Get your API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Embedding Model Configuration (Google Gemini - FREE)
EMBEDDING_MODEL=gemini-embedding-001

# Vector Store Configuration
VECTOR_SEARCH_INDEX_NAME=vector_index
TRANSACTION_CHUNK_SIZE=5

# CORS Configuration (optional - for specific frontend URL)
# FRONTEND_URL=http://localhost:5173
