{
	"name": "@finsight/backend",
	"version": "1.0.0",
	"description": "FinSight AI Backend - RAG-Driven Personal Finance Manager",
	"main": "dist/server.js",
	"type": "module",
	"scripts": {
		"dev": "bun run --watch src/server.ts",
		"start": "bun run src/server.ts",
		"build": "tsc -p tsconfig.prod.json",
		"build:clean": "rm -rf dist && bun run build",
		"db:reset": "bun run dist/scripts/resetDb.js"
	},
	"private": true,
	"devDependencies": {
		"@types/bun": "latest"
	},
	"dependencies": {
		"@finsight/shared": "*",
		"@langchain/core": "^1.1.39",
		"@langchain/google-genai": "^2.1.26",
		"@langchain/mongodb": "^1.1.0",
		"@langchain/openai": "^1.4.3",
		"@langchain/textsplitters": "^1.0.1",
		"@types/compression": "^1.7.5",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/express-serve-static-core": "^5.1.1",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/uuid": "^10.0.0",
		"bcryptjs": "^3.0.3",
		"compression": "^1.8.0",
		"cors": "^2.8.6",
		"dotenv": "^17.4.1",
		"express": "^5.2.1",
		"express-rate-limit": "^7.5.0",
		"express-validator": "^7.3.2",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.3",
		"langchain": "^1.3.1",
		"mongodb": "^7.1.1",
		"mongoose": "^9.4.1",
		"typescript": "^5.8.3",
